{
  "name": "aperture-ts",
  "private": true,
  "version": "0.0.1",
  "description": "TypeScript L402 runtime for Cloudflare Workers",
  "scripts": {
    "build": "pnpm -r build",
    "build:wasm": "make -C packages/wasm build",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r --filter='./packages/*' test",
    "test:e2e": "pnpm -r --filter='./tests/*' test",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean && make -C packages/wasm clean",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "tsup": "^8.4.0",
    "@cloudflare/workers-types": "^4.20250310.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
